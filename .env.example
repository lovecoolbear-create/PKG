# 本地开发（默认，SQLite）
# 与 prisma/schema.sqlite.prisma 配合；无需修改即可本地开发。
DATABASE_URL="file:./dev.db"

# ===== 切换到 Postgres / Neon 时，把上面一行替换为： =====
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 分享链接域名（可选；不配则部署后用 Vercel 自动域名）
# NEXT_PUBLIC_BASE_URL="https://your-app.vercel.app"

# ===== LLM / AI 能力（入口一/二/三）=====
# 任意 OpenAI 兼容大模型（OpenAI / DeepSeek / 通义千问 / 本地 vLLM 等）
# 不配置则自动回退：自然语言解析→关键词规则；纸价→本地基准价；SQE诊断→模板段落。
LLM_API_KEY=""
# 兼容 OpenAI 的 Base URL（留空默认 https://api.openai.com/v1）
# DeepSeek 示例：https://api.deepseek.com/v1
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=""
# 模型名（留空默认 gpt-4o-mini）
LLM_MODEL=""
# 温度（可选，默认 0.2）
# LLM_TEMPERATURE="0.2"

# ===== 可选：联网行情检索（入口二纸价实时抓取）=====
# 配置后纸价将先走联网检索 + 大模型提炼；不配则仅用大模型知识估算。
# 以 Tavily 为例（也支持自建搜索 API，按相同请求/响应结构）
SEARCH_API_KEY=""

# ===== 成本公式管理（私密页 /admin/formula）=====
# 鉴权为 fail-closed：未配置则页面与接口一律拒绝（与知识库页面的 fail-open 相反）。
# 本地开发建议配置；**公网部署不要配置**，这样公式管理在公网根本不可用。
FORMULA_ADMIN_TOKEN=""

# DSL 兜底总开关：默认关闭。
# 仅在确有「8 种结构化计算方式表达不了」的成本项时才开启。
# 开启后仍受白名单约束：白名单函数 + 上下文白名单变量 + 步数/深度上限，绝不用 eval。
FORMULA_DSL_ENABLED="false"

# 公式管理页总开关：设 false 可连页面能力一起关闭（公网构建建议）。
# FORMULA_ADMIN_ENABLED="false"
# SEARCH_API_URL="https://api.tavily.com/search"
