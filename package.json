{
  "name": "cost-analysis-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "vercel-build": "prisma generate --schema prisma/schema.prisma && prisma db push --schema prisma/schema.prisma && next build",
    "db:generate": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:sqlite": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "prebuild": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "postinstall": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "node scripts/sync-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push:pg": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx scripts/golden-regression.ts && tsx scripts/verify-recipe-coverage.ts && tsx tests/review-readonly.test.ts && tsx tests/admin-auth.test.ts && tsx tests/cost-formula.test.ts && tsx tests/recipe-kb-fallback.test.ts && tsx tests/formula-write-guard.test.ts && tsx tests/formula-draft-override.test.ts && tsx tests/cost-formula-dsl.test.ts && tsx scripts/calc-test.ts && tsx tests/p8-consistency.test.ts && tsx tests/physics-feasibility.test.ts && tsx tests/role-policy.test.ts && tsx tests/rule-lifecycle.test.ts",
    "test:golden": "tsx scripts/golden-regression.ts",
    "test:golden:update": "tsx scripts/golden-regression.ts --update",
    "test:recipe-coverage": "tsx scripts/verify-recipe-coverage.ts",
    "test:guardrail": "tsx scripts/verify-input-guardrail.ts",
    "test:kernel": "tsx scripts/verify-sensitivity-kernel.ts",
    "test:unit-norm": "tsx scripts/verify-unit-normalizer.ts",
    "test:binding": "tsx scripts/verify-binding-rates.ts",
    "seed:recipes": "tsx scripts/seed-recipes.ts",
    "test:calc-compare": "tsx scripts/calc-test.ts",
    "test:calibration": "tsx scripts/calibration-test.ts",
    "test:calibration:real": "tsx scripts/calibration-real.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "pdf-to-img": "^6.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
