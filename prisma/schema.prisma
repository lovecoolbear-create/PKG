// ============================================================================
// 生产数据源（PostgreSQL / Neon）
// ----------------------------------------------------------------------------
// 这是部署到 Vercel 时使用的数据源：
//   - provider = "postgresql"
//   - url 来自环境变量 DATABASE_URL（Vercel 后台配置为 Neon 连接串）
//
// 本地开发若想继续用 SQLite，见 prisma/schema.sqlite.prisma，
// 并通过 `npm run db:generate:sqlite` / `npm run db:push` 使用该 schema。
// 两个 schema 共用同一个 DATABASE_URL 变量：本地 .env 写 file:./dev.db，
// Vercel 写 postgresql://...，由各自 schema 的 provider 决定协议。
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // Vercel 运行时（Amazon Linux 2023）需要预编译的引擎二进制
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 产品类型配置（可扩展）
model ProductType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  config      String   // JSON: 字段定义、成本维度、公式配置
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses AnalysisSession[]
}

// 分析会话（知识库核心）
model AnalysisSession {
  id            String   @id @default(cuid())
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  status        String   @default("draft") // draft | analyzing | completed | failed

  // 输入数据
  inputData     String   // JSON: 用户填写的所有字段
  uploadedFiles String?  // JSON: 上传文件元数据
  completeness  Float    @default(0) // 信息完整度 0-100

  // 分析结果
  resultData    String?  // JSON: 完整分析报告
  totalCostMin  Float?
  totalCostMax  Float?
  confidence    Float?

  // Agent 执行记录
  agentLogs     String?  // JSON: 各 Agent 输出与校验日志

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sharedReports SharedReport[]
  knowledgeEntries KnowledgeEntry[]
}

// 可分享报告链接
model SharedReport {
  id          String   @id @default(cuid())
  sessionId   String
  session     AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

// 知识库条目（用于后续训练迭代）
model KnowledgeEntry {
  id          String   @id @default(cuid())
  sessionId   String?
  session     AnalysisSession? @relation(fields: [sessionId], references: [id])
  category    String   // material_price | process_rate | labor_rate | rule | feedback
  key         String
  value       String   // JSON
  source      String   @default("analysis") // analysis | manual | import | feedback
  confidence  Float    @default(50)
  tags        String?  // JSON array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, key])
}

// 成本规则库（规则公式，非 AI 自由发挥）
model CostRule {
  id          String   @id @default(cuid())
  productType String   // 关联产品类型 code
  dimension   String   // 成本维度 key
  name        String
  formula     String   // 公式表达式或 JSON 规则
  parameters  String   // JSON: 参数定义与默认值
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productType, dimension])
}

// ============================================================================
// AI 降本规则闭环（P9）：LLM 蒸馏提案 → 确定性 PostgreSQL 规则
// ----------------------------------------------------------------------------
// 设计要点：
// - 与 CostRule（成本引擎公式）解耦，本表专存「降本案例/规则」及其生命周期。
// - 字段同时兼容 PostgreSQL（生产）与 SQLite（本地 dev.db）：embedding 用
//   JSON 字符串存储（应用内余弦）；生产启用 pgvector 时详见 rule-lifecycle.ts
//   的迁移 DDL 与 SQL 检索路径说明。
// - 生命周期（规格2）：usageCount / triggerCount / conflictCount /
//   lastTriggeredAt / deprecatedAt / status(ACTIVE|DEPRECATED|PENDING)。
// - 元数据（规格3 确定性预过滤）：boxType / material / loadClass。
// ============================================================================
model CostReductionRule {
  id           String    @id @default(cuid())
  // 来源：若由 PendingRule 一键转换而来，记录其 id（可追溯，但 AI 不直写本表）
  sourceRuleId String?
  title        String
  target       String // material_price|flute_config|grammage_floor|process_rate|loss_rate|other
  // 元数据（确定性预过滤用）
  productType  String // 产品类型 code（如 corrugated_box）
  boxType      String? // single_wall|double_wall|triple_wall|folding_carton|rigid
  material     String? // kraft|recycled|white_top|testliner|special
  loadClass    String? // light|medium|heavy（由堆码载荷/箱重派生）
  // 确定性规则内容
  description  String
  proposedValue String
  ruleJson     String // JSON: 结构化确定性规则 {kind, params, formula, applyTo}
  formula      String? // 人类可读公式（可选）
  parameters   String? // JSON: 参数定义与默认值（可选）
  confidence   Float    @default(50)
  evidence     String? // 反推依据（来自真实案例对比）
  // 生命周期（规格2 TTL）
  status          String    @default("ACTIVE") // ACTIVE | DEPRECATED | PENDING
  usageCount      Int       @default(0)
  triggerCount    Int       @default(0)
  conflictCount   Int       @default(0)
  lastTriggeredAt DateTime?
  deprecatedAt    DateTime?
  // 语义向量（规格3；JSON 数组字符串，应用内余弦；生产可迁 pgvector）
  embedding String?
  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productType, status])
  @@index([boxType, material, loadClass])
}

/// 成本项配方（C3 公式资产化 · 把公式从硬编码变成可管理资产）
/// ----------------------------------------------------------------
/// 每个品类下按维度（材料/人工/加工/设计制版/财务）挂若干成本项，
/// 每项 = 一种「计算方式（kind）」+ 参数 + 适用条件。
///
/// 铁律：
///  - 参数里的**可变数值一律引用知识库 key**，写为
///    { kb: "category:key", fallback: number }，**不写死数值**——
///    可变数据归 KB，公式只表达结构（对应调研中「硬编码可变值」这条坑）；
///  - 引擎「读配方 → 逐项求值」，**读不到时回退现有硬编码**，保证行为不变
///    （由 scripts/golden-regression.ts 的黄金基线保证零漂移）；
///  - kind="formula" 为 DSL 兜底，仅在 FORMULA_DSL_ENABLED 开启时启用，
///    且服务端沙箱白名单求值，绝对禁 eval / new Function。
model CostItem {
  id String @id @default(cuid())

  // 归属：品类 → 维度
  productType String // color_print_box | corrugated_box | flat_print
  dimension   String // material | labor | process | design_plate | finance_other
  name        String // 成本项名（面纸 / 坑纸 / 油墨 CMYK / 制版费 / 管理费…）

  // 计算方式（一等机制）：flat | unit_rate | area_rate | weight_rate |
  // ink_rate | tiered | stepped | percent_of | formula(DSL 兜底)
  kind String
  // JSON：该 kind 所需参数。数值须写为 { kb: "category:key", fallback: number }
  params String
  // JSON 数组：适用条件，如 [{ field: "fluteType", op: "!=", value: "none" }]
  conditions String?

  // 权重 / 占比（用户决策：占比直接可改，如管理费 6%、利润 8% 落在这里）
  weight    Float   @default(1)
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  // 版本与时间维度（复用 C6 参数时间维度设计）
  version       Int       @default(1)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  // draft=未启用（引擎忽略）| active=生效中 | archived=已归档
  status String @default("draft")

  // 经验依据（护城河的可读化沉淀：这个系数为什么取这个值）
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productType, dimension, status])
  @@index([productType, dimension, sortOrder])
}

/// 配方变更审计（F5 · 用户决策：免审批但必须有审计日志）
/// ----------------------------------------------------------------
/// 每次新增/修改/删除/启停成本项都留痕，记录前后值，便于回溯
/// "这个系数什么时候被改成这个值的、原来是多少"。
/// 三期接入用户系统后，actor 字段改为实际用户 ID。
model CostItemAudit {
  id String @id @default(cuid())

  /** 被变更的成本项 id；删除场景仍保留该 id 以便追溯 */
  costItemId String
  action     String // create | update | delete | toggle
  /** 变更人（当前为本地管理员标识；三期接入登录後改为用户 ID） */
  actor String @default("local-admin")

  /** 变更前后快照（JSON 字符串）；create 时 before 为 null */
  before String?
  after  String?
  /** 变更说明（可选） */
  reason String?

  createdAt DateTime @default(now())

  @@index([costItemId, createdAt])
}

